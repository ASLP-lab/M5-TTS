  "rules": [
    {
      "name": "url",
      "pattern": "(?:https?://|www\\.)[^\\s<>，。！？；]+",
      "handler": "keep",
      "ignore_case": true
    },
    {
      "name": "email",
      "pattern": "(?<![A-Za-z0-9_.+-])[A-Za-z0-9_.+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "handler": "keep",
      "ignore_case": false
    },
    {
      "name": "date",
      "pattern": "(?<![A-Za-z0-9_])([0-9]{4})[-/.]([0-9]{1,2})[-/.]([0-9]{1,2})(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "date",
      "ignore_case": false
    },
    {
      "name": "date_zh",
      "pattern": "(?<![A-Za-z0-9_])([0-9]{4})年\\s*([0-9]{1,2})月\\s*([0-9]{1,2})[日号]",
      "handler": "date",
      "ignore_case": false
    },
    {
      "name": "year_month",
      "pattern": "(?<![A-Za-z0-9_])([0-9]{4})年\\s*([0-9]{1,2})月",
      "handler": "year_month",
      "ignore_case": false
    },
    {
      "name": "year",
      "pattern": "(?<![A-Za-z0-9_])([0-9]{4})年",
      "handler": "year",
      "ignore_case": false
    },
    {
      "name": "month_day",
      "pattern": "(?<![A-Za-z0-9_])([0-9]{1,2})月\\s*([0-9]{1,2})[日号]",
      "handler": "month_day",
      "ignore_case": false
    },
    {
      "name": "time",
      "pattern": "(?<![A-Za-z0-9_])([0-9]{1,2}):([0-9]{2})(?::([0-9]{2}))?(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "time",
      "ignore_case": false
    },
    {
      "name": "phone",
      "pattern": "(?<![A-Za-z0-9_])(1[3-9][0-9](?:[- ]?[0-9]{4}){2}|0[0-9]{2,3}-[0-9]{7,8})(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "phone",
      "ignore_case": false
    },
    {
      "name": "context_digits",
      "pattern": "(身份证号码|code|快递单号|手机号码|电话号码|身份证号|邮政编码|银行卡号|OTP|PIN|序列号|房间号|手机号|校验码|订单号|门牌号|验证码|ID|口令|学号|密码|工号|帐号|房号|电话|编号|账号|邮编)(\\s*(?:[:：]|是|为)?\\s*)([0-9]+)(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "context_digits",
      "ignore_case": true
    },
    {
      "name": "ip",
      "pattern": "(?<![A-Za-z0-9_])([0-9]{1,3})\\.([0-9]{1,3})\\.([0-9]{1,3})\\.([0-9]{1,3})(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "ip",
      "ignore_case": false
    },
    {
      "name": "version",
      "pattern": "(?<![A-Za-z0-9_])(?:[vV]([0-9]+(?:\\.[0-9]+)+)|([0-9]+(?:\\.[0-9]+){2,}))(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "version",
      "ignore_case": false
    },
    {
      "name": "range",
      "pattern": "(?<![A-Za-z0-9_])([+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+(?:\\.[0-9]+)?|[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+))\\s*[-~～至到]\\s*([+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+(?:\\.[0-9]+)?|[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+))\\s*(km/h|CNY|EUR|GBP|GHz|HKD|MHz|RMB|USD|kHz|m/s|min|GB|Hz|KB|MB|TB|cm|kW|kg|km|m2|m3|mA|mL|mV|mW|mg|ml|mm|ms|m²|m³|ug|°C|°F|μg|万元|亿元|A|L|V|W|g|h|l|m|s|℃|℉|㎡|元|岁|个|天|年|次|人)(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "range",
      "ignore_case": false
    },
    {
      "name": "currency",
      "pattern": "(?<![A-Za-z0-9_])([¥￥$€£]|USD|CNY|RMB|EUR|GBP|HKD)\\s*([+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+(?:\\.[0-9]+)?|[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+))(?:人民币|美元|欧元|英镑|港元|元)?(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "currency",
      "ignore_case": false
    },
    {
      "name": "percent",
      "pattern": "(?<![A-Za-z0-9_])([+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+(?:\\.[0-9]+)?|[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+))\\s*([%‰])(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "percent",
      "ignore_case": false
    },
    {
      "name": "fraction",
      "pattern": "(?<![A-Za-z0-9_])([+-]?[0-9]+)\\s*/\\s*([0-9]+)(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "fraction",
      "ignore_case": false
    },
    {
      "name": "measurement",
      "pattern": "(?<![A-Za-z0-9_])([+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+(?:\\.[0-9]+)?|[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+))\\s*(km/h|CNY|EUR|GBP|GHz|HKD|MHz|RMB|USD|kHz|m/s|min|GB|Hz|KB|MB|TB|cm|kW|kg|km|m2|m3|mA|mL|mV|mW|mg|ml|mm|ms|m²|m³|ug|°C|°F|μg|万元|亿元|A|L|V|W|g|h|l|m|s|℃|℉|㎡|元)(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "measurement",
      "ignore_case": false
    },
    {
      "name": "scientific",
      "pattern": "(?<![A-Za-z0-9_])([+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+(?:\\.[0-9]+)?|[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+))[eE]([+-]?[0-9]+)(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "scientific",
      "ignore_case": false
    },
    {
      "name": "identifier",
      "pattern": "(?<![A-Za-z0-9_])(?=[A-Za-z0-9_.+/-]*[A-Za-z])(?=[A-Za-z0-9_.+/-]*[0-9])[A-Za-z0-9][A-Za-z0-9_.+/-]*(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "keep",
      "ignore_case": false
    },
    {
      "name": "acronym",
      "pattern": "(?<![A-Za-z0-9_])(HTTPS|HTML|HTTP|JSON|ONNX|API|APK|ASR|CPU|CSS|DNS|GPU|LLM|NLP|PDF|RAM|RTF|SDK|SQL|SSD|SSH|TCP|TTS|UDP|URL|USB|VPN|AI)(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "acronym",
      "ignore_case": false
    },
    {
      "name": "number",
      "pattern": "(?<![A-Za-z0-9_.])([+-]?(?:[0-9]{1,3}(?:,[0-9]{3})+(?:\\.[0-9]+)?|[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+))(?![A-Za-z0-9_]|\\.[0-9])",
      "handler": "number",
      "ignore_case": false
    }
  ]
}
